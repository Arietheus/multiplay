# Get a free Postgres connection string from Neon (see README) and paste it here.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Render sets PORT automatically. Only needed for local dev:
# PORT=3000

# Optional: comma-separated usernames granted admin commands (/skip, /slag, ...)
ADMIN_USERS=
